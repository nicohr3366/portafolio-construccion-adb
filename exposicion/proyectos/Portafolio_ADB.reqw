{
 "id": "PortafolioADB",
 "documents": [
  {
   "id": "REQ",
   "name": "Requisitos - Portafolio ADB",
   "attributes": {
    "type": {
     "name": "Tipo",
     "type": "enum",
     "values": [
      {
       "key": "SEC",
       "label": "Sección"
      },
